<?xml version="1.0" encoding="utf-8"?>
<!--
    Demo 阶段：全量放行明文 HTTP，便于把任意电脑 IP（含 DHCP 变动）作为后端地址联调。
    上线前请收紧：把 base-config 改回 cleartextTrafficPermitted="false"，再用
    domain-config 精确列出允许明文的主机（localhost / 127.0.0.1 / 10.0.2.2 / 具体 NAS IP）。
    外部下载 / 接口（GitHub、NAS）若走 HTTPS，本配置与它们无关。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
